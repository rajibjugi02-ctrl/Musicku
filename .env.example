# ─── Musicku Environment Variables Template ──────────────────────────────────
# Salin file ini menjadi '.env' atau '.env.local' dan lengkapi nilai kredensialnya.
# JANGAN PERNAH mengunggah file '.env' asli yang berisi password ke GitHub!

# ─── App Configuration ────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_random_32_character_secret_key_here

# ─── Database (PostgreSQL / Neon / Supabase) ──────────────────────────────────
# Contoh: postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/musicku

# ─── Spotify Developer API (https://developer.spotify.com/dashboard) ──────────
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=your_spotify_client_id_here

# ─── Google OAuth (https://console.cloud.google.com) ──────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
